1 24 "manifest.xml"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Giorgos Gasparis"
            VALUE "FileDescription", "Xilinx ISE 14.7 Native Windows 11 Deployment Suite"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Xilinx_Win11_Deployer"
            VALUE "LegalCopyright", "Copyright (C) 2026 Giorgos Gasparis"
            VALUE "OriginalFilename", "Xilinx_Win11_Deployer.exe"
            VALUE "ProductName", "Xilinx ISE 14.7 Windows 11 Native Deployer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
